<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="route-deck"
        Arguments=""
        InstallLocation="C:\Program Files\MACROX TECHNOLOGIES\RouteDeck">
    </Installer>
    <PackageInformation
        PackageName="RouteDeck"
        PackageDisplayName="RouteDeck"
        PublisherName="CN=MACROX TECHNOLOGIES"
        PublisherDisplayName="MACROX TECHNOLOGIES"
        Version="0.1.0.0"
        PackageDescription="Per-app proxy policy for macOS">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="pro.macrox.routedeck"
                Description="Per-app proxy policy for macOS"
                DisplayName="RouteDeck"
                ExecutableName="route-deck"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>RouteDeck</DisplayName>
            <PublisherDisplayName>MACROX TECHNOLOGIES</PublisherDisplayName>
            <Description>Per-app proxy policy for macOS</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="route-deck.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
